const fileMap = {
  intake: "packets/intake.json",
  research: "packets/research.json",
  approval: "packets/approval.json",
  execution: "packets/execution.json",
  validation: "packets/validation.json",
  pass: "packets/pass.json",
  wrappers: "registries/wrappers.json",
  skills: "registries/skills.json",
  scores: "registries/scores.json",
  vaults: "vaults/index.json",
  ledger: "ledger/events.json",
  ollama: "config/ollama.json",
} as const;

async function ensureFile<T>(relativePath: string, fallback: T) {
  const target = path.join(runtimeRoot, relativePath);
  await mkdir(path.dirname(target), { recursive: true });

  try {
    await readFile(target, "utf8");
  } catch {
    await writeFile(target, JSON.stringify(fallback, null, 2), "utf8");
  }
}

async function readJson<T>(relativePath: string): Promise<T> {
  const target = path.join(runtimeRoot, relativePath);
  const raw = await readFile(target, "utf8");
  return JSON.parse(raw) as T;
}

export async function ensureRuntimeStorage() {
  await ensureFile(fileMap.intake, packetSeeds.intake);
  await ensureFile(fileMap.research, packetSeeds.research);
  await ensureFile(fileMap.approval, packetSeeds.approval);
  await ensureFile(fileMap.execution, packetSeeds.execution);
  await ensureFile(fileMap.validation, packetSeeds.validation);
  await ensureFile(fileMap.pass, packetSeeds.pass);
  await ensureFile(fileMap.wrappers, wrapperRegistrySeed);
  await ensureFile(fileMap.skills, skillRegistrySeed);
  await ensureFile(fileMap.scores, scoreMemorySeed);
  await ensureFile(fileMap.vaults, vaultSeeds);
  await ensureFile(fileMap.ledger, ledgerSeed);
  await ensureFile(fileMap.ollama, ollamaSeed);
}

export async function loadRuntimeStorage() {
  await ensureRuntimeStorage();

  const [
    intakePackets,
    researchPackets,
    approvalPackets,
    executionPackets,
    validationPackets,
    passPackets,
    wrapperRegistry,
    skillRegistry,
    scoreMemory,
    vaultEntries,
    ledgerEvents,
    ollamaConfig,
  ] = await Promise.all([
    readJson<IntakePacket[]>(fileMap.intake),
    readJson<ResearchPacket[]>(fileMap.research),
    readJson<ApprovalPacket[]>(fileMap.approval),
    readJson<ExecutionPacket[]>(fileMap.execution),
    readJson<ValidationPacket[]>(fileMap.validation),
    readJson<PassPacket[]>(fileMap.pass),
    readJson<WrapperRegistryEntry[]>(fileMap.wrappers),
    readJson<SkillRegistryEntry[]>(fileMap.skills),
    readJson<ToolScoreMemory[]>(fileMap.scores),
    readJson<VaultEntry[]>(fileMap.vaults),
    readJson<LedgerEvent[]>(fileMap.ledger),
    readJson<OllamaConfig>(fileMap.ollama),
  ]);

  return {
    intakePackets,
    researchPackets,
    approvalPackets,
    executionPackets,
    validationPackets,
    passPackets,
    wrapperRegistry,
    skillRegistry,
    scoreMemory,
    vaultEntries,
    ledgerEvents,
    ollamaConfig,
  };
}
